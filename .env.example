# Copy to .env.local (gitignored) and fill in. Nothing here is required to build
# or run the public site -- without BLOB_READ_WRITE_TOKEN the content store
# serves the seed read-only, which is exactly what CI does.

# --- Admin credentials (used from Stage B onwards) ---
# Rotation is "change the value and redeploy" by design: there is no writable
# user store, so there is no self-service password change.
ADMIN_USERNAME=
# pbkdf2$<iterations>$<salt_b64>$<hash_b64> -- generated by scripts/hash-password.mjs
ADMIN_PASSWORD_HASH=

# Signs the session cookie. 32+ random bytes:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
SESSION_SECRET=
# Bump to invalidate every issued session at once ("log out everywhere").
SESSION_VERSION=1

# --- Storage ---
# Vercel Blob read/write token. Unset, reads fall back to the seed and every
# save fails loudly. Must be set in production.
BLOB_READ_WRITE_TOKEN=
